# Copiar a .env y completar. No guardar credenciales aquí: en local, Airflow
# las lee de ~/.aws (setup.sh las copia a .secrets/aws); en EC2 vienen del
# rol de la instancia, y user_data crea este archivo.

# Bucket del data lake: terraform -chdir=terraform/s3 output bucket_name
S3_BUCKET=noticias-data-lake-<ACCOUNT_ID>
AWS_REGION=us-east-2

# Workgroup y base de datos que crea terraform/catalog (estos son los valores
# por defecto del código; solo hace falta cambiarlos si se renombran).
ATHENA_WORKGROUP=noticias-data-lake
ATHENA_DATABASE=noticias_data_lake

# Usuario del contenedor de Airflow: 50000 es el usuario airflow de la imagen.
AIRFLOW_UID=50000
